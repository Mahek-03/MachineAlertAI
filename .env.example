# MachineAlert AI Environment Configuration Template

# Server Settings
PORT=8000
ENVIRONMENT=development

# Database Configuration (SQLite default; can point to PostgreSQL)
DATABASE_URL=sqlite:///./machinealert.db
# DATABASE_URL=postgresql://user:password@localhost:5432/machinealert

# Multi-Tier Risk Thresholds (% Failure Probability)
THRESHOLD_NORMAL_MAX=30.0
THRESHOLD_MEDIUM_MAX=60.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Deployment specifics
PROJECT_ID=machinealert-ai
REGION=us-central1
